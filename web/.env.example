# hevy2garmin web dashboard (Next.js). Copy to .env.local for a local run; on Vercel set these as
# project environment variables. Names must match exactly; values are examples.

# Required
DATABASE_URL=postgres://user:password@host/dbname          # Neon or any Postgres; shared with the Python dashboard and the CLI
# POSTGRES_URL, STORAGE_URL and NEON_DATABASE_URL are also accepted, in that
# order of preference with POSTGRES_URL first. Attaching a Neon database through
# Vercel Storage sets POSTGRES_URL for you, so you usually need not set anything.
H2G_PASSWORD=change-me                                       # dashboard login password (plain); or set H2G_PASSWORD_HASH (argon2) instead
HEVY2GARMIN_SECRET=change-me-32-random-chars                 # signs the login session cookie; H2G_SECRET is accepted too (Python-compatible derivation)
# H2G_PASSWORD_HASH=$argon2id$...                            # instead of H2G_PASSWORD: output of `hevy2garmin hash-password` (argon2)
CRON_SECRET=change-me-32-random-chars                        # Vercel Cron / GitHub Actions call /api/cron/sync with this bearer

# Optional
HEVY_API_KEY=                                                # leave EMPTY if you save the key in-app at /setup: when set, this WINS over the saved key (resolution is arg, then env, then the DB), so rotating in-app has no effect until you clear it here
GITHUB_PAT=                                                  # for auto-sync via GitHub Actions on your fork; normally saved in-app
GITHUB_REPO=you/hevy2garmin                                  # your fork, for the auto-sync workflow dispatch
GARMIN_LOGIN_WORKER_URL=                                     # override the Garmin login Worker used by /setup (leave empty for the default)
H2G_DIRECT_GARMIN_LOGIN=                                     # self-hosted only: true = sign in to Garmin from THIS server (password and code go only to Garmin); no login Worker, ignores GARMIN_LOGIN_WORKER_URL. Needs one long-running process, not serverless
H2G_SERVER_SYNC_SCHEDULE=                                    # self-hosted only: how often this server's own scheduler calls /api/cron/sync, e.g. "every 2 hours"; shown instead of the auto-sync toggle, which drives GitHub Actions
DEMO_MODE=false                                              # true = read-only demo (every mutating /api call is refused)
H2G_BASE_PATH=                                               # BUILD time: serve under a path prefix, e.g. /tools/hevy2garmin (README: Under a sub-path)
H2G_UPDATE_CHECK=                                            # off = no "update available" banner on the dashboard (on by default; it asks GitHub at most every 6 hours)
H2G_UPSTREAM_REPO=                                           # the repo your fork follows, for that banner (default: drkostas/hevy2garmin)

# Hevy webhook on a self-hosted server (ignored on Vercel). Wait, try merge-only, upload only on the last attempt.
# WEBHOOK_DELAY_SECONDS=300                                  # before the first attempt, so the watch activity can reach Garmin
# WEBHOOK_RETRY_INTERVAL_SECONDS=600                         # between attempts
# WEBHOOK_MAX_ATTEMPTS=3                                     # 1 means a single attempt that may upload
# WEBHOOK_MAX_INFLIGHT=4                                     # staged syncs at once; past this a webhook is declined (still 200)

# Optional visit counter and error reports: with both set, each page view, and each uncaught error in a
# visitor's browser (through /api/client-error), is posted to {COLLECTOR_URL}/collect in the background.
# COLLECTOR_URL=                                             # your collector's base URL
# COLLECTOR_TOKEN=                                           # sent as a Bearer token
# COLLECTOR_PAGE=                                            # page name to report (default: the request host)
